# Claude Code working directory (local plans, specs, settings)
.claude/

# Python bytecode / caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Build / packaging outputs
build/
dist/
*.egg-info/
.eggs/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Defensive: local runtime artifacts must never be committed. These normally live under
# ~/.config and ~/.local/state, but are ignored here too in case a test or run misfires.
/generated-litellm.yaml
/proxy.json
/proxy.lock
